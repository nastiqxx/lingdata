    <TIER ANNOTATOR="nastiqxx" LINGUISTIC_TYPE_REF="utterance"
        PARTICIPANT="@aas2008f" TIER_ID="text@aas2008f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1"
                TIME_SLOT_REF1="ts19" TIME_SLOT_REF2="ts23">
                <ANNOTATION_VALUE>ну в целом </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a55"
                TIME_SLOT_REF1="ts24" TIME_SLOT_REF2="ts25">
                <ANNOTATION_VALUE>эээ по сравнению с школой / было / максимально</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a56"
                TIME_SLOT_REF1="ts26" TIME_SLOT_REF2="ts28">
                <ANNOTATION_VALUE>спокойно / максимально всё / расслабленно / просто / но / единственное это то что / много пар / и / дорога занимает много времени / и /  вот я выхожу / в восьмом часу и возвращаюсь в семь вечера / это конечно не очень / а так / в целом / ну / семинары очень даже интересные / особенно китайский </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a59"
                TIME_SLOT_REF1="ts30" TIME_SLOT_REF2="ts31">
                <ANNOTATION_VALUE>ну вообще у меня есть такое впечатление</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a65"
                TIME_SLOT_REF1="ts33" TIME_SLOT_REF2="ts34">
                <ANNOTATION_VALUE>да</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER ANNOTATOR="nastiqxx" LINGUISTIC_TYPE_REF="utterance"
        PARTICIPANT="@fal2008m" TIER_ID="text@fal2008m">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts1" TIME_SLOT_REF2="ts18">
                <ANNOTATION_VALUE> ммм / как тебе / первые / три недели / вообще вот типа в Вышке? Чё происходило?</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a57"
                TIME_SLOT_REF1="ts27" TIME_SLOT_REF2="ts29">
                <ANNOTATION_VALUE>китайский да / кстати #кивает# но вот есть впечатление такое да / что / как сказать / что от тебя ничё не требуется на самом деле? то есть как бы ты можешь что-то делать можешь не делать и это вообще типа не важно / ну то есть пока не дошло до там / оценок каких-то</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a60"
                TIME_SLOT_REF1="ts32" TIME_SLOT_REF2="ts35">
                <ANNOTATION_VALUE>ну вот мне это как-то непривычно если честно показалось то есть меня / всегда как бы / по жизни подпинывали можно так сказать / когда чтобы что-то делать вот / а щас / ну такого нет то есть у меня такое единственный раз было / когда / вот олимпиадами мы занимались / это единственная была сфера / где меня никто не подпинывал я должен был сам типа учиться и местами это тяжело давалось / но / в общем это такой / новый опыт довольно</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
