            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1155"
                TIME_SLOT_REF1="ts62" TIME_SLOT_REF2="ts76">
                <ANNOTATION_VALUE>ии вот я выхожу в восьмом часу и возвращаюсь в семь вечера</ANNOTATION_VALUE>
