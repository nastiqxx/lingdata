            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1153"
                TIME_SLOT_REF1="ts42" TIME_SLOT_REF2="ts55">
                <ANNOTATION_VALUE>нуу единственное это то что много пар</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1154"
                TIME_SLOT_REF1="ts56" TIME_SLOT_REF2="ts61">
